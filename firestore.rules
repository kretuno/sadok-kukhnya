rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function membership(orgId) {
      return get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid));
    }

    function isMember(orgId) {
      return signedIn() && membership(orgId).data.active == true;
    }

    function hasRole(orgId, roles) {
      return isMember(orgId) && membership(orgId).data.role in roles;
    }

    match /organizations/{orgId} {
      allow read: if isMember(orgId);
      allow create: if signedIn() && request.resource.data.createdBy == request.auth.uid;
      allow update: if hasRole(orgId, ['admin', 'director']);
      allow delete: if false;

      match /members/{userId} {
        allow read: if isMember(orgId);
        allow create, update: if hasRole(orgId, ['admin', 'director']);
        allow delete: if false;
      }

      match /auditEvents/{eventId} {
        allow read: if isMember(orgId);
        allow create: if isMember(orgId)
          && request.resource.data.authUid == request.auth.uid
          && request.resource.data.id == eventId;
        allow update: if isMember(orgId)
          && request.resource.data == resource.data;
        allow delete: if false;
      }

      match /devices/{deviceId} {
        allow read: if isMember(orgId);
        allow create, update: if isMember(orgId)
          && request.resource.data.authUid == request.auth.uid;
        allow delete: if hasRole(orgId, ['admin', 'director']);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

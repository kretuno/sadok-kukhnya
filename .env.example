# Public Firebase web configuration. These values identify the project; they are not admin secrets.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Stable identifier of the kindergarten inside Firestore, for example: kzdo-145.
VITE_FIREBASE_ORGANIZATION_ID=
